# ── Judge ───────────────────────────────────────────────────────────────────
# jev   = TypeSafe's hosted Jev (fast, best generalisation; prompt leaves your machine)
# local = an Ollama model emulating Jev's three question types (nothing leaves your machine)
JUDGE=jev
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
LOCAL_JUDGE_MODEL=qwen3:4b

# ── Local models (Ollama) ────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_SMALL_MODEL=llama3.2:3b
# Optional bigger local model for private + harder prompts (leave empty to skip)
LOCAL_BIG_MODEL=

# ── Cloud models (OpenRouter) ────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CLOUD_MODEL=deepseek/deepseek-v4.1-flash
# ":online" turns on OpenRouter's web-search plugin for that model
WEB_MODEL=deepseek/deepseek-v4.1-flash:online
FRONTIER_MODEL=anthropic/claude-opus-5
FRONTIER_ENABLED=false

# ── Image lane ───────────────────────────────────────────────────────────────
# openrouter = any OpenRouter model with "image" in its output modalities
# local      = an OpenAI-compatible /v1/images/generations server on your machine
# off        = disable the lane
IMAGE_PROVIDER=openrouter
IMAGE_MODEL=openai/gpt-5.4-image-2
LOCAL_IMAGE_URL=http://localhost:8188/v1/images/generations

# ── Routing thresholds (editable live from the UI too) ───────────────────────
PRIVATE_THRESHOLD=0.5
WEB_THRESHOLD=0.6
LOCAL_MAX_DIFFICULTY=1.5
FRONTIER_DIFFICULTY=3.5
MIN_CATEGORY_CONFIDENCE=0.5
LONG_PROMPT_TOKENS=16000

# ── Price estimates for the stats panel (USD per 1M tokens) ──────────────────
CLOUD_PRICE_IN=0.12
CLOUD_PRICE_OUT=0.48
FRONTIER_PRICE_IN=5
FRONTIER_PRICE_OUT=25
JEV_PRICE_IN=0.042

# ── Server ───────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
DB_PATH=router.sqlite3
